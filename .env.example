# ──────────────────────────────────────────────
#  Verdict — AI Investment Research Agent
#  Environment Variables
# ──────────────────────────────────────────────

# ── LLM Provider (default: Groq — FREE) ───────
# Set LLM_PROVIDER to switch: "groq" | "anthropic" | "openai"
LLM_PROVIDER=groq

# ── Groq (FREE — recommended) ─────────────────
# Get your free key at: https://console.groq.com
# Free tier: ~14,400 requests/day on Llama 3.3 70B
GROQ_API_KEY=gsk_...

# ── Anthropic Claude (paid) ───────────────────
# Get your key at: https://console.anthropic.com/
# Requires credit balance: https://console.anthropic.com/settings/billing
# ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (paid) ────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Web Search (Tavily) ────────────────────────
# Get your free key at: https://app.tavily.com/
# Free tier: 1,000 searches/month
TAVILY_API_KEY=tvly-...

# ── Optional overrides ─────────────────────────
# LLM_MODEL=llama-3.3-70b-versatile   # default for Groq
# RATE_LIMIT_RPM=5
